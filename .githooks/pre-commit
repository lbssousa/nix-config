#!/usr/bin/env bash
set -euo pipefail

FLAKE_ROOT="$(git rev-parse --show-toplevel)"
cd "$FLAKE_ROOT"

# Coleta apenas os arquivos .nix staged para commit
STAGED_NIX=$(git diff --cached --name-only --diff-filter=ACMR | grep '\.nix$' || true)

if [[ -z "$STAGED_NIX" ]]; then
  exit 0
fi

echo "🔍 Verificando arquivos Nix staged..."

# Executa um comando nix capturando stderr separadamente.
# Falha se o exit code for != 0 OU se o stderr contiver evaluation warnings (^warning:).
nix_check() {
  local label="$1"
  shift
  local stderr_tmp
  stderr_tmp=$(mktemp)
  "$@" 2>"$stderr_tmp"
  local exit_code=$?
  if grep -q "^warning:" "$stderr_tmp"; then
    cat "$stderr_tmp" >&2
    echo "  ⚠️  Evaluation warnings detectados em: ${label}" >&2
    rm -f "$stderr_tmp"
    return 1
  fi
  if [[ -s "$stderr_tmp" ]]; then
    cat "$stderr_tmp" >&2
  fi
  rm -f "$stderr_tmp"
  return "$exit_code"
}

# 1. Formatação
echo "  → nixfmt (formato)"
# shellcheck disable=SC2086
if ! nix_check "nixfmt" nix run nixpkgs#nixfmt -- --check $STAGED_NIX; then
  echo ""
  echo "❌ Arquivos com formatação incorreta ou evaluation warnings. Execute para corrigir:"
  echo "   nix run nixpkgs#nixfmt -- $STAGED_NIX"
  echo "   (ou: just fmt)"
  exit 1
fi

# 2. Lint estático
echo "  → statix (lint)"
if ! nix_check "statix" nix run nixpkgs#statix -- check .; then
  echo ""
  echo "❌ Erros de lint (statix). Execute para ver detalhes:"
  echo "   just lint"
  exit 1
fi

# 3. Código morto
echo "  → deadnix (código morto)"
if ! nix_check "deadnix" nix run nixpkgs#deadnix -- --fail .; then
  echo ""
  echo "❌ Código morto detectado (deadnix). Execute para ver detalhes:"
  echo "   just deadcode"
  exit 1
fi

echo "✅ Validações Nix aprovadas."
