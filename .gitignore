# Gitignore para o nixos-config
# Arquivos e diretórios sensíveis que NÃO devem ser commitados

# --- Camada privada ---
# Clone lbssousa/nixos-config-private aqui e force-add ao índice git:
#   git clone git@github.com:lbssousa/nixos-config-private private
#   git add --force private/
# Ver docs/private-layer.md para detalhes.
/private

# --- Configurações de usuário ---
# Os arquivos de usuário real ficam em users/ mas NÃO são commitados
# Use users/skeleton.nix como template para criar seu usuário
/users/*.nix
# Exceto o template skeleton (deve ser commitado como referência):
!/users/skeleton.nix

# --- Segredos e chaves ---
*.key
*.pem
*.p12
*.pfx
secrets/
.secrets

# --- Hardware específico ---
# O hardware-configuration.nix gerado automaticamente pode sobrescrever os templates
# Opcional: descomente para ignorar os arquivos de hardware gerados
# hosts/*/hardware-configuration.nix

# --- Arquivos temporários ---
*.swp
*.swo
*~
.DS_Store
.direnv/
result
result-*

# --- Nix ---
.nix-profile
.nix-defexpr
.nix-channels

# --- Flake lock (opcional - depende do workflow) ---
# Manter o flake.lock commitado para builds reproduzíveis
# flake.lock
nixfmt
