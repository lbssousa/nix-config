# Gitignore for nixos-config
# Sensitive files and directories that must NOT be committed

# --- Secrets and keys ---
*.key
*.pem
*.p12
*.pfx
# Plaintext secret files must never be committed.
# sops-encrypted files (*.yaml) are safe to commit.
secrets/*
!secrets/*.yaml
.secrets

# --- Host-specific hardware ---
# The auto-generated hardware-configuration.nix can overwrite the templates
# Optional: uncomment to ignore generated hardware files
# hosts/*/hardware-configuration.nix

# --- Temporary files ---
*.swp
*.swo
*~
.DS_Store
.direnv/
result
result-*

# --- Nix ---
.nix-profile
.nix-defexpr
.nix-channels

# --- Flake lock (optional - depends on the workflow) ---
# Keep flake.lock committed for reproducible builds
# flake.lock
nixfmt
